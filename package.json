{
  "name": "discordforgejs",
  "private": true,
  "description": "Monorepo for the DiscordForge JavaScript packages",
  "workspaces": [
    "packages/types",
    "packages/sdk",
    "packages/cli"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @discordforgejs/sdk"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "dotenv": "^17.3.1",
    "tsup": "^8.0.2",
    "typescript": "^5.4.3",
    "vitest": "^4.1.2"
  },
  "license": "MIT"
}
